<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A macOS app extension must be sandboxed; the iOS entitlements file
	     has no equivalent key because iOS sandboxes everything anyway. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The one container the widget shares with the app. On macOS this
	     resolves with the team identifier prefix a sandboxed group requires;
	     see METoolkitShared/SharedStore.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ME_APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
