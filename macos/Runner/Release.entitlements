<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- StoreKit's product query, purchase and restore, and the privacy-policy
	     link opened from Settings. Without this a sandboxed build silently
	     reports the store as unavailable. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The `printing` package's Print/PDF panel, used by the PDF report. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Writing an exported PDF or CSV to wherever the save panel points.
	     Scoped to what the user picks in the panel; grants nothing else. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
